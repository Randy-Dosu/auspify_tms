# ---------------------------------------------------------------------------
# Copy this file to `backend/.env` and fill in real values:
#     cp backend/.env.example backend/.env
#
# Generate strong keys with:
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development

# 1 = Flask debug mode (development only!). MUST be 0 in production.
APP_DEBUG=0

# Flask session/CSRF signing key. Required, no default.
SECRET_KEY=replace-me-with-64-random-hex-chars

# JWT signing key (keep different from SECRET_KEY). Required, no default.
JWT_SECRET_KEY=replace-me-with-another-64-random-hex-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30

# SQLite file, relative to backend/ or absolute. Created on first run.
DATABASE_PATH=instance/exam_system.db

# Let the human status page at "/" be shown inside a hosted preview iframe.
# API responses are never embeddable. Defaults to 1 outside production.
ALLOW_PREVIEW_EMBEDDING=1

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port the API listens on.
PORT=5000

# --- Seed accounts used by seed.py (development only) ---
SEED_ADMIN_EMAIL=admin@auspify.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_TEACHER_EMAIL=teacher@auspify.test
SEED_TEACHER_PASSWORD=replace-with-a-strong-password
SEED_STUDENT_PASSWORD=replace-with-a-strong-password
SEED_STUDENT1_EMAIL=student1@auspify.test
SEED_STUDENT2_EMAIL=student2@auspify.test
SEED_STUDENT3_EMAIL=student3@auspify.test

# --- Login hardening ---
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT="10 per minute"
REGISTER_RATE_LIMIT="20 per minute"
